# Copy to `.env` and fill in. Restart backend to apply.
# When SUPABASE_* are unset, service stays dormant — every Inspector /
# Compare / Inference feature still works in single-user mode.

# Supabase — get these from Project Settings → API. Keep URL empty for local
# single-user mode; any non-empty value enables service auth.
SUPABASE_URL=
# Example: https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# First admin's email — used by scripts/bootstrap_admin.py
ADMIN_BOOTSTRAP_EMAIL=you@example.com

# BYOK: secret used to encrypt users' stored agent API keys at rest.
# Required for the account "Agent credentials" feature; when unset, saving
# a key returns 503 and generation falls back to the host's agent auth.
# Any passphrase works (derived via SHA-256), or a real Fernet key.
# HA_CREDS_ENC_KEY=change-me-to-a-long-random-secret

# Contribute→PR (Phase 5): the admin "Approve & Create PR" action opens a PR
# with a contributed spec. The backend never merges — a human merges on GitHub.
# Two auth modes (App preferred; when neither is set, create-PR returns 503):
#
#   GitHub App (recommended) — PRs come from the app's bot identity, not a
#   person's account. Create an App with Contents + Pull requests (write),
#   install it on the repo, then set:
# HA_GITHUB_APP_ID=123456
# HA_GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END...   # \n-escaped or base64
# HA_GITHUB_APP_INSTALLATION_ID=12345678   # optional; auto-discovered from the repo
#
#   Fine-grained PAT (fallback) — simpler, but PRs open under the token owner:
# HA_GITHUB_TOKEN=github_pat_xxx
#
# HA_GITHUB_REPO=shenh10/HuggingArch

# Optional: rate limits (req/min). 0 disables.
# ANALYZE_RPM=60
# INFERENCE_RPM=120

# Autonomous op propose/review/promote watcher. On by default in every mode;
# set 0 to turn it off.
# OP_PIPELINE_ENABLED=0

# Optional: local vLLM / sglang source checkouts for the op-proposal /
# op-review agents (they derive FLOPs by reading real kernel source, not
# papers). Default to vendor/vllm and vendor/sglang under the repo root.
# HA_VLLM_SRC=/path/to/vllm
# HA_SGLANG_SRC=/path/to/sglang
